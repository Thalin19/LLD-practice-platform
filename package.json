{
  "name": "lld-practice-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "node --test tests/domain.test.ts tests/storage.test.ts tests/application.test.ts tests/http.test.ts tests/evaluator.test.ts tests/worker.test.ts tests/gemini.test.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "vite build",
    "dev": "vite",
    "demo": "npm run build && node src/preview-server.ts",
    "test:ui": "npm run build && playwright test",
    "db:init": "node src/infrastructure/sqlite/initialize.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
